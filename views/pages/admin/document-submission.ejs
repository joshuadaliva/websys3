<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document Submission · Arkipaisi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin/application-management.css" />
</head>
<body>
  <div class="main" style="margin-left:0;max-width:1100px;margin:0 auto">
    <div class="content">
      <div class="panel" style="margin-top:24px">
        <div class="panel-head" style="border-bottom:1px solid var(--border)">
          <div>
            <div class="panel-title">Document Submission for Qualification</div>
            <div style="font-size:12px;color:var(--text-muted);margin-top:3px">ARKIPAISI › Applications › Upload Requirements</div>
          </div>
          <span class="badge b-submitted">SECURE LINK</span>
        </div>

        <div style="padding:16px;border-bottom:1px solid var(--border)">
          <div class="info-chip blue">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>Please upload all required documents for qualification. Link expires on <strong>March 18, 2026</strong>.</div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:16px">
          <div>
            <div class="form-group"><label class="form-label">Applicant Name</label><input class="form-control" value="Carla M. Bautista" readonly /></div>
            <div class="form-group"><label class="form-label">Stall Applied</label><input class="form-control" value="#06 · Dry Goods" readonly /></div>
            <div class="form-group"><label class="form-label">Valid Government ID</label><input type="file" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Selfie with ID</label><input type="file" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Business Permit (PDF)</label><input type="file" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Barangay Clearance (PDF)</label><input type="file" class="form-control" /></div>
            <div class="form-group"><label class="form-label">Signed Application Form (PDF)</label><input type="file" class="form-control" /></div>
            <button class="btn primary sm" onclick="alert('Documents submitted successfully.')">Submit Documents</button>
          </div>
          <div class="panel" style="margin:0">
            <div class="panel-head"><div class="panel-title">Submission Guide</div></div>
            <div style="padding:14px 16px;font-size:13px;color:var(--text-secondary);line-height:1.55">
              <p>• Upload clear, readable files only (JPG, PNG, or PDF).</p>
              <p>• Maximum file size: 10 MB per document.</p>
              <p>• Ensure all names and details match your application.</p>
              <p>• Incomplete uploads may delay qualification review.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
